# Outsmart harness (TrueForge, standalone mode).
#
# Binds to localhost only. Caddy terminates TLS and handles auth in front of it
# - standalone mode ignores OIDC entirely, so authentication cannot live here.
#
# This is a TEMPLATE, not a ready-to-install unit: User= carries a
# __RUN_USER__ placeholder that must be substituted with the account the
# harness was provisioned under. deploy/setup.sh does this for you.
#
# Install (normal path):
#   sudo ./deploy/setup.sh          # installs this unit with the right user
#   sudo systemctl enable --now trueforge
#
# Install (by hand):
#   sed "s/__RUN_USER__/$USER/" deploy/trueforge.service | sudo tee /etc/systemd/system/trueforge.service > /dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now trueforge
#
# Kept on one line deliberately: a "\" continuation would be joined with the
# next comment line, and the "#" would then comment out the pipe.

[Unit]
Description=Outsmart harness (TrueForge standalone)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=/opt/outsmart

# The sandbox runtime creates its proxy socket at $TMPDIR/claude-http-<id>.sock.
# TrueForge only bind-mounts /tmp/claude and /tmp/tf_cms into the sandbox, so
# without this the socket is invisible inside it and every sandbox init fails
# with "ProxyError: Cannot connect to proxy".
Environment=TMPDIR=/tmp/claude
Environment=PORT=8790

# Bind to loopback only. TrueForge already defaults to localhost
# (DEFAULT_HOST = "localhost", passed as `hostname` to @hono/node-server), but
# this is a security property and should not depend on an upstream default:
# anything that can reach this port bypasses Caddy's authentication and talks
# straight to a harness that executes code.
Environment=HOST=127.0.0.1
ExecStartPre=/usr/bin/mkdir -p /tmp/claude

# --no-network-family-autoselection: on NAT64 networks Node's happy-eyeballs
# connector races IPv4 and IPv6 and times out on both, making some model
# providers unreachable with a bare "Cannot connect to API".
ExecStart=/usr/bin/node \
  --no-network-family-autoselection \
  --dns-result-order=ipv4first \
  /opt/outsmart/node_modules/@truefoundry/trueforge/dist/cli.js

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
